# Copy to config/career-ops.env and adjust. Real environment variables win.
#
# The installed career-ops checkout is READ-ONLY. Do not point any writable
# directory below at it.
# CAREER_OPS_UPSTREAM=$HOME/.local/share/career-ops

# CAREER_OPS_HOME=$HOME/code/jobgremlin
# CAREER_OPS_CONFIG=$CAREER_OPS_HOME/config
# CAREER_OPS_DATA=$CAREER_OPS_HOME/data
# CAREER_OPS_OUTPUT=$CAREER_OPS_HOME/output
# CAREER_OPS_SCRIPTS=$CAREER_OPS_HOME/scripts

# Browser used by the parallel run (leave unset to reuse the current login).
# LINKEDIN_PROFILE_DIR=$HOME/.local/share/browser-profiles/linkedin-parallel
# CDP_PORT=9334
# CHROMIUM_BIN=/bin/chromium

# Hard deadline for one browser operation. A frozen renderer is detected at
# this limit, recorded with a grim screenshot, and the job becomes retryable.
# CAREER_OPS_RENDERER_TIMEOUT_SECONDS=30

# Deadline for a whole easyapply run (form fill or submit) by career-ops-run.
# CAREER_OPS_APPLY_TIMEOUT_SECONDS=420

# Answers file. Defaults to the workspace copy, then the upstream one.
# CAREER_OPS_ANSWERS=$CAREER_OPS_CONFIG/answers-hermes.json

# CV used when career-ops-run receives no --cv. When unset, the newest
# output/cv-*.pdf in the workspace wins. In --candidates mode an unset CV
# enables the per-job cache instead.
# CAREER_OPS_CV=$CAREER_OPS_OUTPUT/cv-renan-geral.pdf

# Minimum weighted skill similarity for reusing a cached CV. The default is
# 0.90; config/cv-cache.json can set {"min_score": 0.95}. Required skills
# weigh three times preferred skills and no must-have skill may be missing.
# CAREER_OPS_CV_MIN_SCORE=0.90

# Optional eligibility rules for the candidate queue. Without this file the
# defaults accept pt/en, frontend/backend/fullstack/mobile and mid/senior.
# The queue itself always lives in $CAREER_OPS_DATA/queue.json.
# See README.md for the JSON shape.

# Daily loop (career-ops-run --candidates --target N).
# Time budget for the whole round; 0 disables it.
# CAREER_OPS_RUN_MAX_SECONDS=14400
# Attempts per job in one round, including transient renderer failures.
# CAREER_OPS_MAX_ATTEMPTS_PER_JOB=2
# Run discovery only when new+jd_fetched+eligible is at or below this number.
# CAREER_OPS_QUEUE_LOW_WATERMARK=5
